# 全局共享虚拟环境（所有项目通用）
.venv/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Agent 运行时状态（checkpoint / trace / otel / patch）
.agent/

# API keys
local.env

# CLI worktrees (kept after a session so edits stay inspectable)
.agent-workspaces/

# 本地开发过程文档
docs/

# Docker build jobs
jobs/

# Local OTel demo export
projects/*/otel.jsonl

# Local build output (CMake)
projects/*/build/

# VsCode 
.vscode/

# Harbor snapshot of shared components. Regenerated by vendor_components.sh.
projects/terminal-coding-agent/vendor/

# Local artifacts
_artifacts/
# Built indices + rendered pages (Settings.artifacts_dir default)
# `/*` excludes the directory's contents, not the directory itself. Excluding
# the directory itself stops git from descending, which would make the `!`
# exception at the bottom dead.
projects/*/artifacts/*
# The ablation sweep's throwaway index (`ingest --out artifacts-ablation`): 100 MB of
# indices and rendered pages, reproducible with one ingest. Only the JSONL results
# under `eval/` are worth keeping.
projects/*/artifacts-ablation/*
# The MMDocIR benchmark's index and its PDF subset (`prepare_mmdocir.py --out artifacts-mmdocir`):
# reproducible from the Hub in one command, so only the JSONL results under `eval/` are kept.
projects/*/artifacts-mmdocir*/*

# Poisoning experiments: generated fixtures and the ~100 MB index working copy are both
# reproducible in seconds (`--build-fixtures`, `prepare()`). The JSONL results are kept: they
# are the only thing a rerun cannot recreate.
projects/*/poisoning/*/fixtures/
projects/*/poisoning/*/work/

# `doc-qa eval`'s default output path (`RESULTS_PATH`) — an append target, so it is
# scratch. Curated mdq runs are committed under explicit names instead
# (`results-<mode>-<n>q*.jsonl`). Deliberately not `projects/*/eval/results.jsonl`:
# tca's eval/results.jsonl is a tracked result.
projects/multimodal-doc-qa/eval/results.jsonl

.DS_Store

# Anchored with the full path: a bare `checkpoints/` would exclude the directory
# itself and make the `!` exception below dead, but `checkpoints/*` would only
# match a repo-root `checkpoints/` (a middle slash anchors the pattern).
projects/*/checkpoints/*
!projects/tiny-llm-pipeline/checkpoints/sync_ckpt.py

!projects/tiny-llm-pipeline/artifacts/prefs/